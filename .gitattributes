# Normaliza finales de linea entre Windows y Linux
* text=auto eol=lf

# El archivo dorado del oraculo se compara literalmente contra la salida de la
# implementacion Python: si git le cambiara un byte, la prueba diferencial
# dejaria de significar lo que dice que significa.
herramientas/salida-python.json text eol=lf
herramientas/corpus.json text eol=lf

# Binarios: git no debe tocarlos.
*.xlsx binary
*.xlsm binary
*.webp binary
*.png binary
